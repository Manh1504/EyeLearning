# psycopg requires a PostgreSQL DSN, not a SQLAlchemy +asyncpg URL.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/eyetracking
CHATBOT_INTERNAL_TOKEN=generate-another-long-random-string

# Chat provider: gemini, deepseek, or local (Ollama).
LLM_NAME=deepseek
GEMINI_LLM_MODEL=gemini-flash-lite-latest
OLLAMA_LLM_MODEL=qwen3.5:9b
OLLAMA_NUM_PREDICT=512
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# GOOGLE_API_KEY=  # Required when LLM_NAME=gemini or EMBEDDING_NAME=gemini.

# Retrieval embedding provider: api, gemini, or local.
EMBEDDING_NAME=api
EMBEDDING_DIM=4096
EMBEDDING_MODEL=qwen3-embedding:8b-ctx16k
OLLAMA_API_URL=http://localhost:11434/api/embed
OLLAMA_SECKEY=

# Slide transcription currently supports local Ollama VLM.
VLM_NAME=local
OLLAMA_VLM_MODEL=qwen3-vl:8b-instruct

# Storage: local, s3, or r2. HTTP(S) image_url values need no credentials.
STORAGE_PROVIDER=local
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
LOCAL_MEDIA_DIR=/app/media
STORAGE_HTTP_ALLOWED_HOSTS=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=

RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.3
