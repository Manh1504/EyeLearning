# ============================================================
# .dockerignore — loại file không cần thiết khỏi build context
# ============================================================

# --- Weights: tải lúc runtime (entrypoint.sh chạy scripts/download_weights.py) ---
weights/
*.safetensors
*.tflite
*.ubj

# --- Python ---
**/__pycache__/
**/*.py[cod]
*$py.class
*.egg-info/
**/.venv/
**/venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# --- Git & bí mật ---
.git/
.gitignore
.env
.env.*

# --- Tài liệu, test & compose (không cần trong image) ---
README.md
*.md
docker-compose*.yml
tests/
requirements-dev.txt
conftest.py
.pytest_cache/

# --- IDE / OS ---
.idea/
.vscode/
.DS_Store
