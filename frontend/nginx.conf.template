map "$request_method:$http_accept" $spa_fallback_for_api {
    default 0;
    "~^GET:.*text/html" 1;
}

# Hỗ trợ upgrade WebSocket (dùng cho location /ai/ bên dưới).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    include /etc/nginx/mime.types;
    types {
        application/javascript mjs;
    }

    # Khớp với giới hạn 100MB hiển thị ở UI upload PDF lesson (mặc định nginx chỉ cho 1MB,
    # thiếu dòng này sẽ gây 413 Request Entity Too Large trước khi request tới được backend).
    client_max_body_size 100M;

    # Nén để tải nhanh hơn (bundle JS/CSS)
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Runtime config được sinh bởi docker-entrypoint.d/20-write-runtime-config.sh — không cache.
    location = /config.js {
        add_header Cache-Control "no-store";
        try_files /config.js =204;
    }

    # Proxy các path API sang backend FastAPI ("web" service) — giữ same-origin,
    # tránh phải cấu hình CORS phức tạp giữa 2 container.
    location = /admin/overview {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # File PDF lesson luôn phải đi backend, không được rơi vào SPA fallback.
    location ^~ /courses/pdf-lessons/file/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # AI Service (Gaze-Estimation) — reverse-proxy HTTP + WebSocket, giữ cùng origin
    # với frontend. Browser gọi /ai/calibrate, /ai/inference thay vì 127.0.0.1:9000 —
    # bắt buộc khi deploy remote (vd. vast.ai) vì browser của học viên không với tới
    # localhost của server. AI_UPSTREAM_AI: host:port của AI service
    # (compose: "ai:9000"; all-in-one: "127.0.0.1:9000").
    location ^~ /ai/ {
        # resolver của Docker DNS + biến để nginx không fail lúc khởi động khi service
        # "ai" chưa tồn tại (chỉ 502 khi gọi thật).
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $ai_upstream ${AI_UPSTREAM_AI};
        rewrite ^/ai/(.*)$ /$1 break;
        proxy_pass http://$ai_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Bỏ Origin để AI service không reject theo AI_WS_ORIGINS khi host public không
        # biết trước — traffic đã đi qua proxy của chính hệ thống, và WebSocket
        # /inference vẫn được xác thực bằng tracking token ký bởi web service.
        proxy_set_header Origin "";
        # WebSocket /inference sống lâu suốt phiên học.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location ~ ^/(auth|courses|sessions|tracking|gaze|metrics|learning-analytics|heatmaps|calibration-profiles|calibration|lessons|lectures|debug|page-snapshots|page-snapshot|client-config|health)(/|$) {
        error_page 418 = /index.html;
        if ($spa_fallback_for_api) {
            return 418;
        }
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Static assets build ra (hash trong tên file) — cache dài hạn.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA fallback cho react-router (client-side routing).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
