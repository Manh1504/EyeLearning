DATABASE_URL=postgresql+asyncpg://eyelearn_user:eyelearn_password@localhost:5433/eyelearn
AI_HTTP_URL=http://127.0.0.1:9000
AI_WS_URL=ws://127.0.0.1:9000/inference

# Optional. If these are not set, generated heatmap images are stored locally
# under data/outputs/heatmaps and served from /heatmaps/file/{filename}.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Alternative single-variable Cloudinary config.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=
