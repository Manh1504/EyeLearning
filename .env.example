# ============================================================
# EyeLearning — một file env duy nhất cho toàn bộ stack.
# Copy ra .env (gitignored) rồi điền giá trị thật: cp .env.example .env
# ============================================================

# ---------- PostgreSQL (docker service `postgres`, cổng host 5435) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eyetracking

# ---------- Backend ----------
# Local dev (python chạy ngoài container, kết nối qua cổng host 5435)
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5435/eyetracking
# Dùng trong docker-compose cho container backend (mạng nội bộ compose)
DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:change-me@postgres:5432/eyetracking

JWT_SECRET=generate-a-long-random-string-gentoo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Production: liệt kê mọi hostname phục vụ frontend, gồm cả apex và www.
CORS_ORIGINS=http://localhost:3000
DEBUG=false

# ---------- AI service (image hieunm1501/gaze-api, cổng host 8000) ----------
AI_HTTP_URL=http://127.0.0.1:8000
AI_WS_URL=ws://127.0.0.1:8000

# ---------- Chatbot RAG ----------
# Backend local gọi chatbot local; trong Docker dùng http://chatbot:8000.
CHATBOT_URL=http://127.0.0.1:8002
CHATBOT_TIMEOUT_SECONDS=60
CHATBOT_INGEST_TIMEOUT_SECONDS=600
CHATBOT_INTERNAL_TOKEN=generate-another-long-random-string
# psycopg DSN (không dùng hậu tố +asyncpg).
CHATBOT_DATABASE_URL=postgresql://postgres:change-me@localhost:5435/eyetracking
CHATBOT_DATABASE_URL_DOCKER=postgresql://postgres:change-me@postgres:5432/eyetracking
LLM_NAME=local
GEMINI_LLM_MODEL=gemini-flash-lite-latest
EMBEDDING_NAME=api
EMBEDDING_DIM=4096
EMBEDDING_MODEL=qwen3-embedding:8b-ctx16k
OLLAMA_API_URL=
OLLAMA_SECKEY=
VLM_NAME=local
OLLAMA_LLM_MODEL=qwen3.5:9b
OLLAMA_NUM_PREDICT=512
OLLAMA_VLM_MODEL=qwen3-vl:8b-instruct
STORAGE_HTTP_ALLOWED_HOSTS=

# Frontend kết nối THẲNG gaze-api (không qua backend). Dùng cho rewrite /gaze/*
# và WebSocket stream /session/{sid}/stream. Local: http://localhost:8000.
# NEXT_PUBLIC_GAZE_URL=http://localhost:8000

# ---------- Gaze tuning ----------
GAZE_DOWNSAMPLE_HZ=4.0
GAZE_BATCH_MAX=2000

# ---------- Cloudinary (tùy chọn — heatmap có thể lưu local) ----------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=

# ---------- Cloudflare R2 (slide storage) ----------
# Ví dụ: bucket eyelearning, public URL https://slides.example.com
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
GEMINI_TIMEOUT=45
