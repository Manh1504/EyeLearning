# ============================================================
# EyeLearning — một file env duy nhất cho toàn bộ stack.
# Copy ra .env (gitignored) rồi điền giá trị thật: cp .env.example .env
# ============================================================

# ---------- PostgreSQL (docker service `postgres`, cổng host 5435) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eyetracking

# ---------- Backend ----------
# Local dev (python chạy ngoài container, kết nối qua cổng host 5435)
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5435/eyetracking
# Dùng trong docker-compose cho container backend (mạng nội bộ compose)
DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:change-me@postgres:5432/eyetracking

JWT_SECRET=generate-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Production: liệt kê mọi hostname phục vụ frontend, gồm cả apex và www.
# Ví dụ: CORS_ORIGINS=https://eyelearning.id.vn,https://www.eyelearning.id.vn
# (backend KHÔNG tự thêm domain nào — giá trị này được truyền nguyên vào container.)
CORS_ORIGINS=http://localhost:3000
DEBUG=false

# ---------- Phiên bản image deploy ----------
# IMAGE_TAG chọn tag của các image ghcr.io/manh1504/eyelearning-* (docker-compose).
# `latest` cho CI tự động; rollback thì đặt về tag bất biến `sha-<commit>` do CI push.
IMAGE_TAG=latest

# ---------- AI service (image hieunm1501/gaze-api, cổng host 8000) ----------
AI_HTTP_URL=http://127.0.0.1:8000
AI_WS_URL=ws://127.0.0.1:8000

# ---------- Chatbot RAG ----------
# Backend local gọi chatbot local; trong Docker dùng http://chatbot:8000.
CHATBOT_URL=http://127.0.0.1:8002
CHATBOT_TIMEOUT_SECONDS=60
CHATBOT_INGEST_TIMEOUT_SECONDS=600
# Retry khi gọi /ingest/slide (5xx/lỗi mạng là tạm thời, vd chatbot cold-start).
CHATBOT_INGEST_ATTEMPTS=3
CHATBOT_INGEST_BACKOFF_SECONDS=5
# Token chia sẻ giữa backend và chatbot (bắt buộc, khác rỗng).
# Backend gửi X-Chatbot-Token cho chatbot; chatbot/backend chặn nếu thiếu/sai.
CHATBOT_INTERNAL_TOKEN=generate-another-long-random-string
# DSN cho chatbot (psycopg thuần — KHÔNG có hậu tố +asyncpg).
# Local: port host 5435. Docker: host `postgres`, port 5432.
CHATBOT_DATABASE_URL=postgresql://postgres:change-me@localhost:5435/eyetracking
CHATBOT_DATABASE_URL_DOCKER=postgresql://postgres:change-me@postgres:5432/eyetracking
# Embedding: local = Qwen3-Embedding-0.6B (1024 chiều, deps + torch cu124 đã có
# trong image chatbot — xem services/chatbot/requirements.txt).
# EMBEDDING_DIM PHẢI khớp số chiều cột vector trong DB (migration 012 → 1024).
# Nếu đổi sang model khác (vd 4096 chiều) phải đổi cột vector tương ứng.
EMBEDDING_NAME=local
EMBEDDING_DIM=1024
# Embedding local: weights tải về volume /app/weights lúc khởi động; chạy trên GPU.
EMBEDDING_MODEL_PATH=/app/weights/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cuda
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_HF_REPO=Qwen/Qwen3-Embedding-0.6B
# HF_TOKEN=            # chỉ cần nếu repo embedding private/rate-limited
# ---------- LLM + VLM: River AI (OpenAI-compatible, không tốn VRAM local) ----------
# LLM: định tuyến/kiểm duyệt/sinh câu trả lời; VLM: mô tả slide lúc ingest.
LLM_NAME=river
VLM_NAME=river
RIVER_API_KEY=
RIVER_BASE_URL=https://api.river.ai/v1
# Model dùng cho LLM/VLM (có thể tách khác nhau nếu muốn):
#   deepseek-ai/DeepSeek-V4.1-Flash-1017 | zai-org/GLM-5.3-Flash
#   nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4 (VL chuyên dụng cho slide)
RIVER_LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
RIVER_VLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# RIVER_LLM_MAX_TOKENS=4096
# RIVER_VLM_MAX_TOKENS=16384
# RIVER_TIMEOUT=180
# Thời gian ân hạn healthcheck chatbot (lần đầu tải embedding có thể vài phút).
CHATBOT_HEALTH_START_PERIOD=1800s
STORAGE_PROVIDER=local
STORAGE_HTTP_ALLOWED_HOSTS=
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.3
# Kích thước ConnectionPool PostgreSQL dùng chung cho chatbot (tùy chọn).
DB_POOL_MIN=1
DB_POOL_MAX=10

# Frontend kết nối THẲNG gaze-api (không qua backend). Dùng cho rewrite /gaze/*
# và WebSocket stream /session/{sid}/stream. Local: http://localhost:8000.
# NEXT_PUBLIC_GAZE_URL=http://localhost:8000

# ---------- Gaze tuning ----------
GAZE_DOWNSAMPLE_HZ=4.0
GAZE_BATCH_MAX=2000

# ---------- Gaze service (tùy chọn) ----------
# Thiết bị suy luận: cpu | cuda (bỏ trống để tự dò GPU).
# DEVICE=cuda
# Giới hạn session calibration trong RAM.
# SESSION_TTL_SECONDS=1800
# MAX_SESSIONS=100
# MAX_POINTS=64
# MAX_SAMPLES_PER_POINT=50
# Số worker suy luận (torch/mediapipe không thread-safe -> mặc định 1).
# INFER_WORKERS=1
# Kích thước ảnh upload tối đa cho /calibrate và /import (bytes).
# MAX_UPLOAD_BYTES=5242880
# Làm mượt One-Euro cho điểm nhìn (POG). Tọa độ là [0,1] theo viewport.
# `beta` là nút chính để BỚT TRỄ: cao hơn -> bám nhanh khi lia mắt.
# ONEEURO_BETA=0.5
# Cutoff khi gần như đứng yên: thấp -> ít rung, cao -> bớt trễ nhưng run hơn.
# ONEEURO_MIN_CUTOFF=0.5
# Cutoff làm mượt ước lượng vận tốc: cao -> thích ứng tốc độ nhanh hơn.
# ONEEURO_D_CUTOFF=1.0

# ---------- Cloudinary (tùy chọn — heatmap có thể lưu local) ----------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=

# ---------- Cloudflare R2 (slide storage) ----------
# Ví dụ: bucket eyelearning, public URL https://slides.example.com
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# ---------- Redis (container backend) ----------
# Backend kết nối Redis qua tên service trong mạng compose. Để trống → backend
# tắt Redis (rate-limit + cache fallback in-memory; chỉ đúng khi chạy 1 process).
REDIS_URL_DOCKER=redis://redis:6379/0

# ---------- Proxy tin cậy & cookie ----------
# Chỉ peer trong dải CIDR này mới được tin header X-Forwarded-For (chống giả mạo IP).
TRUSTED_PROXY_IPS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# Cookie auth: COOKIE_SECURE=true ở production (HTTPS), false khi dev localhost.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ---------- Cloudflare Tunnel ----------
# BẮT BUỘC cho service cloudflared (tunnel trỏ vào nginx).
CLOUDFLARE_TUNNEL_TOKEN=
