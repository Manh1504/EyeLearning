# One-shot migrations runner — dùng khi bind mount ./db/migrations không tới
# được container postgres (vd Portainer paste-compose stack).
# Chạy 1 lần trên cùng compose network rồi xóa container.
# Env: PGHOST (mặc định postgres), PGUSER (postgres), PGDATABASE (eyetracking), PGPASSWORD (bắt buộc).
FROM postgres:16

COPY db/migrations /migrations

CMD ["bash", "-c", "for f in /migrations/*.sql; do echo \"=== $f ===\"; psql -h \"${PGHOST:-postgres}\" -U \"${PGUSER:-postgres}\" -d \"${PGDATABASE:-eyetracking}\" -v ON_ERROR_STOP=1 -f \"$f\" || exit 1; done"]
